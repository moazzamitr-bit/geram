# Environment — Gram
# Never commit real secrets. Copy to .env.production on the server.

# --- Mode -----------------------------------------------------------------
# SANDBOX: demo (fixed OTP, simulated deposits)
# CLOSED_BETA: real users, Postgres required, no simulated money
# PRODUCTION: also requires approved market data
GERAM_EXECUTION_MODE=SANDBOX

# --- Supabase (auth + app data) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://wlxlobhetjbrhbfpsmzp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required for SMS OTP, admin ops, cron and random login passwords.
SUPABASE_SERVICE_ROLE_KEY=

# --- Financial core ledger (Postgres connection string) ---------------------
# Without this, buy/sell/deposit return "misconfigured" on a deployed server.
DATABASE_URL=

# --- Login -------------------------------------------------------------------
# Default is phone + password (/api/auth/password-login and /api/auth/register).
# SMS OTP is used only when BOTH Kavenegar vars below are set. Until then
# POST /api/auth/phone-login returns method_disabled. No extra env is required
# for password login. Register needs SUPABASE_SERVICE_ROLE_KEY so the phone
# user is created already confirmed.
# Self-hosted: NEXT_PUBLIC_SUPABASE_URL must be the browser URL, including a
# path prefix (https://example.com/sb). The app tolerates a missing trailing
# slash. The reverse proxy must forward /auth/v1 and Set-Cookie.
# Kavenegar verify/lookup template with one %token% placeholder.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
# Random 32+ chars; salts stored OTP hashes.
OTP_HASH_SECRET=
# Only used without a service role; random 32+ chars.
PHONE_AUTH_PEPPER=
# SANDBOX only: the fixed demo code.
DEMO_OTP=123456

# --- Cron ------------------------------------------------------------------
# Bearer secret for /api/cron/revenue (Authorization header only).
CRON_SECRET=

# --- Optional switches (admin panel can also stop flows) --------------------
# TRADING_ENABLED=true
# DEPOSIT_ENABLED=true
# GERAM_MARKET_DATA_PRODUCTION_APPROVED=false
