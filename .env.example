# Environment — Gram
# Never commit real secrets. Copy to .env.production on the server.

# --- Mode -----------------------------------------------------------------
# SANDBOX: demo (fixed OTP). User self-serve deposit stays off unless the flag below is true.
# CLOSED_BETA: real users, Postgres required, no simulated money
# PRODUCTION: also requires approved market data
# Stay SANDBOX for the closed beta. Do not set PRODUCTION.
GERAM_EXECUTION_MODE=SANDBOX

# User self-serve sandbox deposit. Keep false on geram.co so invitees cannot mint IRR.
# Set true only for a local demo.
SANDBOX_DEPOSIT_ENABLED=false

# --- Supabase (auth + app data) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://wlxlobhetjbrhbfpsmzp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required for SMS OTP, admin ops, cron and random login passwords.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, server-only, read at runtime (not a Docker build arg).
# When set, route handlers and middleware call this origin instead of the
# public URL above. Leave it unset and the server keeps the public URL.
# Browser code never reads this. No /sb suffix: Caddy strips that prefix
# before the gateway. On the current self-hosted stack the gateway container
# is supabase-envoy (also reachable as kong on network supabase_default):
# SUPABASE_INTERNAL_URL=http://supabase-envoy:8000

# --- Financial core ledger (Postgres connection string) ---------------------
# Without this, buy/sell/deposit return "misconfigured" on a deployed server.
DATABASE_URL=

# --- Login method ------------------------------------------------------------
# password (default): mobile + password, no SMS, number NOT verified (pre-launch).
# /auth/login renders that form immediately. phone-login returns method_disabled
# until this is otp. Register needs SUPABASE_SERVICE_ROLE_KEY.
# otp: one-time SMS code via sms.ir / Kavenegar below.
# Self-hosted: NEXT_PUBLIC_SUPABASE_URL is the browser URL, including a path
# prefix (https://example.com/sb). Do not strip Set-Cookie at the proxy.
# Do not change GERAM_EXECUTION_MODE for the login fix.
AUTH_METHOD=password

# --- Login / SMS OTP ---------------------------------------------------------
# sms.ir Verify API (preferred). Template 123456 = sandbox (owner's number only);
# real users need an approved template (sms.ir requires eNamad / business licence).
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=123456
SMSIR_PARAM_NAME=Code
# Kavenegar verify/lookup template with one %token% placeholder (alternative).
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
# Random 32+ chars; salts stored OTP hashes.
OTP_HASH_SECRET=

# --- Finnotech (server only: KYC Shahkar + optional SMS OTP) ---------------
# Never commit real values. Tokens are minted on the server and are not stored.
# FINNOTECH_NID is the 10-digit national id of the person who may call the client.
# FINNOTECH_SMS_SENDER is the Finnotext line. Required only for finnotext OTP.
# FINNOTECH_OTP_CHANNEL=messaging (default) or finnotext.
# AUTH_METHOD stays password until you deliberately switch login to OTP.
FINNOTECH_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_NID=
FINNOTECH_SMS_SENDER=
# FINNOTECH_OTP_CHANNEL=messaging
# FINNOTECH_TIMEOUT_MS=12000

# Buy/sell require profiles.kyc_status=VERIFIED.
# Unset: ON in PRODUCTION, OFF in SANDBOX and CLOSED_BETA.
# REQUIRE_KYC_FOR_TRADE=true
# Not used for login. OTP sessions use the service role and do not change the password.
PHONE_AUTH_PEPPER=
# SANDBOX only: the fixed demo code.
DEMO_OTP=123456

# --- Cron ------------------------------------------------------------------
# Bearer secret for /api/cron/revenue (Authorization header only).
CRON_SECRET=

# --- Optional switches (admin panel can also stop flows) --------------------
# TRADING_ENABLED=true
# DEPOSIT_ENABLED=true
# GERAM_MARKET_DATA_PRODUCTION_APPROVED=false
